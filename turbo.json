{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "@support/web#build": {
      "dependsOn": ["^build"],
      "env": [
        "AUTHENTICATION_ATTEMPT_WINDOW_SECONDS",
        "AUTHENTICATION_LOCKOUT_SECONDS",
        "AUTHENTICATION_MAX_ATTEMPTS",
        "AUTHENTICATION_PASSWORD_RESET_TTL_SECONDS",
        "AUTHENTICATION_SESSION_TTL_SECONDS",
        "AUTHENTICATION_SUDO_WINDOW_SECONDS",
        "AUTHENTICATION_TWO_FACTOR_RECOVERY_HOLD_SECONDS",
        "DATABASE_CA_CERTIFICATE",
        "DATABASE_CONNECTION_TIMEOUT_MS",
        "DATABASE_IDLE_TIMEOUT_MS",
        "DATABASE_POOL_MAX",
        "DATABASE_SSL_MODE",
        "DATABASE_STATEMENT_TIMEOUT_MS",
        "DATABASE_URL",
        "LOG_LEVEL",
        "NEXT_PUBLIC_SITE_URL",
        "OIDC_CLIENT_ID",
        "OIDC_CLIENT_SECRET",
        "OIDC_ISSUER_URL",
        "OIDC_REDIRECT_URI",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_EXPORTER_OTLP_HEADERS",
        "OTEL_RESOURCE_ATTRIBUTES",
        "OTEL_SERVICE_NAME",
        "SAML_CALLBACK_URL",
        "SAML_ENTRY_POINT",
        "SAML_IDP_CERTIFICATE",
        "SAML_ISSUER",
        "SCIM_BEARER_TOKEN",
        "SMTP_FROM_ADDRESS",
        "SMTP_HOST",
        "SMTP_PASSWORD",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USERNAME",
        "STRIPE_CUSTOMER_PORTAL_RETURN_URL",
        "STRIPE_SECRET_KEY",
        "STRIPE_SUBSCRIPTION_PRICE_ID",
        "STRIPE_WEBHOOK_SECRET",
        "SUPPORT_DEVELOPMENT_AUTH_PASSWORD",
        "SUPPORT_RUNTIME_MODE",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "WEBAUTHN_ORIGIN",
        "WEBAUTHN_RP_ID",
        "WEBAUTHN_RP_NAME"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    }
  }
}
