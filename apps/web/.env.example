# Optional canonical public URL override. Vercel deployments otherwise use
# VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=

# Structured server logging. Supported values: debug, info, warn, error, silent.
LOG_LEVEL=info

# OpenTelemetry is opt-in. Leave the endpoint empty to disable trace and metric export.
OTEL_SERVICE_NAME=support-web
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional standard OpenTelemetry resource attributes and authentication headers.
OTEL_RESOURCE_ATTRIBUTES=
OTEL_EXPORTER_OTLP_HEADERS=

# Supabase is the only production runtime. All values in this section are
# required; missing values fail closed during server composition.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=support-media

# Real Supabase Auth account used only by Playwright smoke tests.
SUPABASE_E2E_ENABLED=
SUPABASE_E2E_EMAIL=
SUPABASE_E2E_PASSWORD=

# Supabase PostgreSQL production runtime. Use a transaction pooler URL in
# Preview and Production. Local Supabase uses its direct local database port.
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_CA_CERTIFICATE=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Select the endpoint represented by DATABASE_URL.
SUPABASE_POSTGRES_CONNECTION_MODE=transaction-pooler

# SMTP notification delivery. Leave SMTP_HOST empty to disable delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Provider-neutral billing with a Stripe adapter. Leave empty until the billing
# context is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=
