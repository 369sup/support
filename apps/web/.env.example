# Optional canonical public URL override. Vercel deployments otherwise use
# VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=

# Structured server logging. Supported values: debug, info, warn, error, silent.
LOG_LEVEL=info

# OpenTelemetry is opt-in. Leave the endpoint empty to disable trace and metric export.
OTEL_SERVICE_NAME=support-web
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional standard OpenTelemetry resource attributes and authentication headers.
OTEL_RESOURCE_ATTRIBUTES=
OTEL_EXPORTER_OTLP_HEADERS=

# Runtime composition. Keep `memory` only for isolated tests. Supabase Auth
# requires the `postgres` runtime.
SUPPORT_RUNTIME_MODE=memory

# Authentication is enabled only when the Supabase PostgreSQL runtime and both
# values below are configured. Otherwise password authentication is unavailable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Real Supabase Auth account used only by Playwright smoke tests.
SUPABASE_E2E_ENABLED=
SUPABASE_E2E_EMAIL=
SUPABASE_E2E_PASSWORD=

# PostgreSQL production runtime. DATABASE_URL is required only when
# SUPPORT_RUNTIME_MODE=postgres. Use verify-full with a trusted CA in production.
DATABASE_PROVIDER=postgres
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_CA_CERTIFICATE=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# When DATABASE_PROVIDER=supabase, choose the connection endpoint represented
# by DATABASE_URL: direct, session-pooler, or transaction-pooler.
SUPABASE_POSTGRES_CONNECTION_MODE=

# Authentication security windows.
#
# AUTH_FACTOR_ENCRYPTION_KEY must be a base64-encoded 32-byte key in
# PostgreSQL mode. Keep it in the deployment secret store.
AUTH_FACTOR_ENCRYPTION_KEY=
AUTHENTICATION_MAX_ATTEMPTS=5
AUTHENTICATION_ATTEMPT_WINDOW_SECONDS=900

# WebAuthn relying-party identity. Production origins must use HTTPS.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Support
WEBAUTHN_ORIGIN=http://localhost:3000

# Optional OpenID Connect provider. Leave every value empty to disable.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Optional SAML provider. Multiline certificates should be supplied by the
# deployment secret store.
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_CALLBACK_URL=
SAML_IDP_CERTIFICATE=

# SCIM bearer authentication. Leave empty until an Enterprise IAM consumer is
# enabled.
SCIM_BEARER_TOKEN=

# SMTP notification delivery. Leave SMTP_HOST empty to disable delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Provider-neutral billing with a Stripe adapter. Leave empty until the billing
# context is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=
