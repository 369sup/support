{
  "mcpServers": {
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--project-from-cwd",
        "--context=codex",
        "--language-backend",
        "JetBrains",
        "--open-web-dashboard=false"
      ],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 330
    }
  }
}
